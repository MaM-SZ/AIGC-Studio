# 服务端地址
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:8080
# 本地联调远程后端：在 .env.local 中将 NEXT_PUBLIC_SERVER_URL 留空，设置此地址。
# 仅开发环境启用，浏览器通过本地 /api/v1 同源代理访问，不影响生产部署。
DEV_SERVER_PROXY_URL=
# 发卡网站地址，留空时购买积分页面显示未配置提示。
NEXT_PUBLIC_CREDIT_STORE_URL=
# ICP备案号
NEXT_PUBLIC_ICP_RECORD_NUMBER=
# 前端展示的项目 GitHub 仓库地址，留空时不显示入口。
NEXT_PUBLIC_GITHUB_URL=https://github.com/Swayingleaves/novanova-studio
